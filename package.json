{
  "name": "dgx-super-agent",
  "version": "1.3.0",
  "type": "module",
  "description": "A single-agent-core harness: a Chief plans your goal into verifiable tasks, Workers run until independent gates pass, and nothing ships on a model's word alone.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CharAzinabulu0079/DGX-Super-Agent.git"
  },
  "bugs": {
    "url": "https://github.com/CharAzinabulu0079/DGX-Super-Agent/issues"
  },
  "homepage": "https://github.com/CharAzinabulu0079/DGX-Super-Agent#readme",
  "keywords": [
    "ai-agents",
    "agent-harness",
    "multi-agent",
    "verification",
    "human-in-the-loop",
    "llm",
    "typescript"
  ],
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "test": "node --test --test-reporter=spec \"superagent/contracts/**/*.test.ts\" \"superagent/plugins/**/*.test.ts\" \"superagent/server/**/*.test.ts\"",
    "test:evals": "node --test --test-concurrency=1 --test-reporter=spec \"superagent/evals/test/*.test.ts\"",
    "test:all": "pnpm test && pnpm test:evals && pnpm test:redteam",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p superagent/ui/tsconfig.json --noEmit",
    "build": "pnpm --filter @superagent/ui run build && pnpm --filter @superagent/dsh-bundle run build",
    "smoke:dsh": "node scripts/smoke-dsh.ts",
    "arch": "node scripts/arch-scan.ts --check",
    "hygiene": "node superagent/cli/src/main.ts hygiene .",
    "check": "pnpm typecheck && pnpm test && pnpm arch && pnpm hygiene",
    "sa": "node superagent/cli/src/main.ts",
    "test:redteam": "node --test --test-concurrency=1 --test-reporter=spec \"superagent/evals/redteam/*.test.ts\"",
    "redteam": "node scripts/redteam-report.ts"
  },
  "dependencies": {
    "@deepseek-ai/dsh": "0.1.7-rc.2"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "^22.19.0",
    "typescript": "^5.9.0"
  }
}
